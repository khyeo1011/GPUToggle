{
  "manifest_version": 3,
  "name": "GPU Toggle",
  "version": "0.0.1",
  "description": "One-click hardware acceleration toggle for Chrome.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "GPU Toggle"
  },
  "permissions": ["nativeMessaging", "storage"],
  "background": {
    "service_worker": "background.js"
  }
}
